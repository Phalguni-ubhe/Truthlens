# ===================================================
# --- Dependencies (The MOST IMPORTANT one) ---
# Prevents uploading thousands of files
# ===================================================
node_modules/


# ===================================================
# --- Secrets & API Keys (The CRITICAL one) ---
# Prevents uploading your secret keys and passwords
# ===================================================
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Firebase admin service account key (if you have one)
serviceAccountKey.json


# ===================================================
# --- Build & Cache Files ---
# These are generated locally, no need to save them
# ===================================================
dist/
build/
.vite-cache/
.next/


# ===================================================
# --- Log Files ---
# ===================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ===================================================
# --- Operating System Files ---
# ===================================================
.DS_Store
Thumbs.db
# Service Account Keys
*.json
# Ignored folders
Truthlens_Docs
